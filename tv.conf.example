# Copy this file to tv.conf and fill it in. tv.conf stays on your computer (it is in .gitignore).

# Your TV's IP address: TV Settings > Network & Internet > (your Wi-Fi) > IP address.
TV_HOST=192.168.1.50

# Shown on Home and on the screensaver, e.g. GREETING_NAME="Asha & Ravi" (keep the quotes). Empty: no name.
GREETING_NAME=

# City for the weather on the screensaver (Open-Meteo, no key needed). Leave empty to hide the weather.
# Use the local spelling if a name is ambiguous, e.g. Bengaluru rather than Bangalore.
WEATHER_CITY=

# Streaming subscriptions shown on the screensaver with the days left. Apps don't share this, so type it in:
#   a fixed end date        Netflix=2026-11-15
#   renews every month      JioHotstar=monthly:5        (on the 5th)
#   renews every year       Prime Video=yearly:03-01    (on 1 March)
# Separate with commas and keep the quotes. Empty: no subscriptions shown.
SUBSCRIPTIONS=""

# Minutes without touching the remote before the screensaver starts. Empty keeps the TV's own setting.
SCREENSAVER_MINUTES=5
