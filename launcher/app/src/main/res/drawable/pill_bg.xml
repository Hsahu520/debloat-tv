<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid glass pill: a translucent body brighter at the top, a specular sheen over the upper half and a light rim;
     focused, it turns to bright milky glass. Same look as Ui.LiquidGlass on the For You, Jarvis and Games screens. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#FAFFFFFF" android:endColor="#E3EAF0FF" />
                    <stroke android:width="1.2dp" android:color="#FFFFFFFF" />
                    <corners android:radius="21dp" />
                </shape>
            </item>
            <item android:bottom="21dp" android:left="2dp" android:right="2dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#80FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:topLeftRadius="20dp" android:topRightRadius="20dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Reorder button while reorder mode is on (focus is on the tiles then). -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#596EC1FF" />
            <stroke android:width="1.5dp" android:color="#FF6EC1FF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#3DFFFFFF" android:centerColor="#1AFFFFFF" android:endColor="#14FFFFFF" />
                    <stroke android:width="1.2dp" android:color="#59FFFFFF" />
                    <corners android:radius="21dp" />
                </shape>
            </item>
            <item android:bottom="21dp" android:left="3dp" android:right="3dp" android:top="1.5dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#38FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:topLeftRadius="19dp" android:topRightRadius="19dp" />
                </shape>
            </item>
            <item android:top="30dp" android:left="6dp" android:right="6dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#00000000" android:endColor="#26000000" />
                    <corners android:bottomLeftRadius="18dp" android:bottomRightRadius="18dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
